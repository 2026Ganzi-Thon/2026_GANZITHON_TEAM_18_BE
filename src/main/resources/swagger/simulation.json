{
  "openapi": "3.0.3",
  "info": {
    "title": "말사이 시뮬레이션 API",
    "version": "1.0.0",
    "description": "요청마다 충돌 정리 결과와 필요한 대화 내역을 전달합니다. 서버는 대화를 저장하지 않습니다. 요청 본문은 최대 96 KiB입니다."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/simulations/start": {
      "post": {
        "tags": [
          "시뮬레이션"
        ],
        "operationId": "startSimulation",
        "summary": "시뮬레이션 시작",
        "description": "충돌 정리 결과를 바탕으로 상대가 먼저 건넬 말을 생성합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "setup"
                ],
                "properties": {
                  "setup": {
                    "$ref": "#/components/schemas/Setup"
                  }
                }
              },
              "example": {
                "setup": {
                  "userName": "연주",
                  "contact": {
                    "name": "민지 선배",
                    "relationCategory": "SENIOR"
                  },
                  "situationType": "GENERAL_REQUEST",
                  "goal": "가능한 시간과 업무 범위를 분명히 전달하기",
                  "conflictContext": {
                    "summary": {
                      "requestContent": "행사 정산 자료 정리"
                    },
                    "responseType": "CONDITIONAL",
                    "availableCondition": "토요일 오전 두 시간",
                    "relatedSchedules": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                }
              }
            }
          },
          "400": {
            "description": "입력값 또는 JSON이 올바르지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "입력값 또는 JSON이 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "413": {
            "description": "요청 본문은 최대 96 KiB입니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "요청 본문은 최대 96 KiB입니다."
                  }
                }
              }
            }
          },
          "429": {
            "description": "AI 요청이 많습니다. 잠시 후 다시 시도해 주세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_BUSY",
                    "message": "AI 요청이 많습니다. 잠시 후 다시 시도해 주세요."
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI 응답을 처리하지 못했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_ERROR",
                    "message": "AI 응답을 처리하지 못했습니다."
                  }
                }
              }
            }
          },
          "504": {
            "description": "AI 응답 시간이 초과됐습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_TIMEOUT",
                    "message": "AI 응답 시간이 초과됐습니다."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulations/chat": {
      "post": {
        "tags": [
          "시뮬레이션"
        ],
        "operationId": "chatSimulation",
        "summary": "대화 이어가기",
        "description": "첫 AI 메시지를 포함한 전체 대화를 보내고 마지막 발화는 USER로 둡니다. 종료 시 마지막 AI 답변을 표시한 뒤 리포트를 요청하세요.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "setup",
                  "messages"
                ],
                "properties": {
                  "setup": {
                    "$ref": "#/components/schemas/Setup"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Message"
                    },
                    "minItems": 1,
                    "maxItems": 41
                  }
                }
              },
              "example": {
                "setup": {
                  "userName": "연주",
                  "contact": {
                    "name": "민지 선배",
                    "relationCategory": "SENIOR"
                  },
                  "situationType": "GENERAL_REQUEST",
                  "goal": "가능한 시간과 업무 범위를 분명히 전달하기",
                  "conflictContext": {
                    "summary": {
                      "requestContent": "행사 정산 자료 정리"
                    },
                    "responseType": "CONDITIONAL",
                    "availableCondition": "토요일 오전 두 시간",
                    "relatedSchedules": []
                  }
                },
                "messages": [
                  {
                    "sender": "AI",
                    "content": "연주야, 행사 정산 자료 정리 좀 도와줄 수 있어?"
                  },
                  {
                    "sender": "USER",
                    "content": "토요일 오전 두 시간만 자료 정리를 도와드릴 수 있어요."
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "입력값 또는 JSON이 올바르지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "입력값 또는 JSON이 올바르지 않습니다."
                  }
                }
              }
            }
          },
          "413": {
            "description": "요청 본문은 최대 96 KiB입니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "요청 본문은 최대 96 KiB입니다."
                  }
                }
              }
            }
          },
          "429": {
            "description": "AI 요청이 많습니다. 잠시 후 다시 시도해 주세요.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_BUSY",
                    "message": "AI 요청이 많습니다. 잠시 후 다시 시도해 주세요."
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI 응답을 처리하지 못했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_ERROR",
                    "message": "AI 응답을 처리하지 못했습니다."
                  }
                }
              }
            }
          },
          "504": {
            "description": "AI 응답 시간이 초과됐습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "AI_TIMEOUT",
                    "message": "AI 응답 시간이 초과됐습니다."
                  }
                }
              }
            }
          }
        }
      }
    },
